# Authrim Configuration
# Get these values from your Authrim Admin Dashboard

# Your Authrim tenant URL
PUBLIC_AUTHRIM_ISSUER=https://your-tenant.authrim.com

# Your application's client ID
PUBLIC_AUTHRIM_CLIENT_ID=your-client-id

# Optional, when this example is entered through the common tenant discovery host.
# PUBLIC_AUTHRIM_TENANT_ID=your-tenant-id
# PUBLIC_AUTHRIM_COMMON_ENTRY_URL=https://auth.example.com

# Server-only secret for encrypting HttpOnly session cookies.
# Use at least 32 bytes of high-entropy random data.
AUTHRIM_SESSION_SECRET=replace-with-at-least-32-random-bytes
